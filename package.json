{
  "name": "orbitalframeworks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:negotiated": "node scripts/serve-negotiation.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:visual": "node scripts/verify-wasy-visual.mjs && node scripts/verify-proof-layout.mjs && node scripts/verify-home-b2b-visual.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:agents": "node scripts/verify-agent-production.mjs"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
